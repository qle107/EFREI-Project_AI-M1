# JWT (set SECRET_KEY in production)
SECRET_KEY=your-secret-key-change-in-production

# Default backend user (default: admin / admin). Set DEMO_PASSWORD_HASH to a bcrypt hash to override.
# DEMO_USERNAME=admin
# DEMO_PASSWORD_HASH=

# Optional: token expiry (defaults: 120 min access, 30 days refresh)
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM Provider: ollama (default), anthropic (Claude), or gemini ---
# LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) ---
# Run `ollama run phi3:mini` in a separate terminal before starting the API.
# LLM_URL=http://localhost:11434/api/generate
# LLM_MODEL=phi3:mini
# LLM_NUM_PREDICT=256
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT=300          # seconds; increase if Ollama times out on slow hardware

# --- Anthropic Claude (when LLM_PROVIDER=anthropic) ---
# Get an API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_MAX_TOKENS=512

# --- Google Gemini (when LLM_PROVIDER=gemini) ---
# Get an API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_TOKENS=512

# --- LLM Response Cache ---
# Identical prompts are cached in memory. Set to 0 to disable.
# LLM_CACHE_TTL=86400          # cache lifetime in seconds (default 24h)
# LLM_CACHE_MAX_SIZE=200       # max cached entries
