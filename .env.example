# JWT (set SECRET_KEY in production)
SECRET_KEY=your-secret-key-change-in-production

# Default backend user (default: admin / admin). Set DEMO_PASSWORD_HASH to a bcrypt hash to override.
# DEMO_USERNAME=admin
# DEMO_PASSWORD_HASH=

# Optional: token expiry
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama LLM (default model: phi3:mini — run `ollama pull phi3:mini` or set a model you have)
# LLM_URL=http://localhost:11434/api/generate
# LLM_MODEL=phi3:mini
